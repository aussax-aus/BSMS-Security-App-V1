{
  "name": "bsms-security-app",
  "version": "1.0.0",
  "description": "Business Security Management System - Comprehensive security app for guard management, patrol tracking, and incident reporting",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm run setup:backend && npm run setup:mobile && npm run setup:admin",
    "setup:backend": "cd packages/backend && npm install",
    "setup:mobile": "cd packages/mobile && npm install",
    "setup:admin": "cd packages/admin && npm install",
    "start:backend": "cd packages/backend && npm start",
    "start:mobile": "cd packages/mobile && npm start",
    "start:admin": "cd packages/admin && npm start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:admin\"",
    "dev:backend": "cd packages/backend && npm run dev",
    "dev:admin": "cd packages/admin && npm run dev",
    "test": "npm run test:backend && npm run test:mobile && npm run test:admin",
    "test:backend": "cd packages/backend && npm test",
    "test:mobile": "cd packages/mobile && npm test",
    "test:admin": "cd packages/admin && npm test",
    "lint": "npm run lint:backend && npm run lint:mobile && npm run lint:admin",
    "lint:backend": "cd packages/backend && npm run lint",
    "lint:mobile": "cd packages/mobile && npm run lint",
    "lint:admin": "cd packages/admin && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "security",
    "guard-management",
    "patrol-tracking",
    "incident-reporting",
    "compliance",
    "nfc",
    "qr-code",
    "gps-tracking"
  ],
  "author": "BSMS",
  "license": "UNLICENSED"
}
